<?xml version="1.0" encoding="utf-8"?>
<!--
   The track history is location data: it must not go
   into the Google cloud backup. Direct device-to-device transfer remains
   allowed, it does not leave the user's hands.

   Preferences are excluded from the cloud for the same reason: `pref_last_lat` /
   `pref_last_lng` keep there the last map position displayed, rewritten at
   every move. Excluding the database without excluding preferences let
   the most telling point of all leave.

   Update APKs (`files/updates`) are excluded from both routes, for a
   reason that is not privacy — they are public and re-downloadable —
   but weight: about twenty MiB, enough to exhaust the backup quota and
   make it fail silently, for a file the app can fetch again
   from GitHub.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="my_tracks_db" />
        <exclude domain="database" path="my_tracks_db-wal" />
        <exclude domain="database" path="my_tracks_db-shm" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="updates" />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="updates" />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
