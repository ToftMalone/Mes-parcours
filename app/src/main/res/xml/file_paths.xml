<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
       The “exports/” subfolder disappeared with the sharing function, removed from
       the interface without its code or this path being removed. Expose nothing that is not
       used: every path declared here is readable by the app to which a URI is passed,
       and an unused path is a surface offered for nothing.

       If sharing ever comes back, this is where a dedicated subfolder will have to be
       reopened — never the whole cache, which also contains the map tiles.
    -->

    <!--
       APKs of downloaded updates. Necessary to present them to
       Android's installer: passing it a file:// would throw a
       FileUriExposedException since Android 7.

       **Internal** storage (`files-path`), not external: see
       `UpdateDownloader.downloadDir`. The external folder remained modifiable by
       any app with the storage permission on Android 9 and earlier,
       even after the fingerprint check.
    -->
    <files-path name="updates" path="updates/" />
</paths>
