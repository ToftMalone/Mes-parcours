<?xml version="1.0" encoding="utf-8"?>
<!--
   Règles de sauvegarde pour Android 11 et antérieur.
   L'historique des parcours (données de localisation) est exclu de la sauvegarde
   automatique, ainsi que le cache de tuiles cartographiques.
-->
<full-backup-content>
    <exclude domain="database" path="my_tracks_db" />
    <exclude domain="database" path="my_tracks_db-wal" />
    <exclude domain="database" path="my_tracks_db-shm" />
    <exclude domain="external" path="." />
</full-backup-content>
