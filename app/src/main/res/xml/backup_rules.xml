<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and earlier.

   The track history is location data: it must not go
   into the automatic backup. Nor must the tile cache, which would reveal the
   areas consulted.

   Preferences are excluded for the same reason, and this is not caution
   for caution's sake: `pref_last_lat` / `pref_last_lng` keep there the last map
   position displayed, rewritten at every move. Without this exclusion, excluding the
   database was pointless — the most telling point of all left anyway.

   Update APKs (`files/updates`) are excluded for a different reason:
   not what they reveal — they are public and re-downloadable — but their
   weight. About twenty MiB went into the backup, enough to exhaust its
   quota and make it fail silently, for a file the app can fetch
   again from GitHub.
-->
<full-backup-content>
    <exclude domain="database" path="my_tracks_db" />
    <exclude domain="database" path="my_tracks_db-wal" />
    <exclude domain="database" path="my_tracks_db-shm" />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="updates" />
    <exclude domain="external" path="." />
</full-backup-content>
